@@ -0,0 +1,1359 @@
+//! PROTOTYPE (bead gd-ww9), throwaway. Answers "what should rendered markdown
+//! look like in tuicr?" by rendering the PR description panel and `.md` diff
+//! rows in one of several variants. Switch live with `:mdv`, or at startup with
+//! `TUICR_MD_PROTO=off|a|b|c`. Lives on the `proto/markdown-render` branch only;
+//! the real renderer gets written properly under epic gd-tni.
+//!
+//! - A glow: glamour's dark style. `##` kept on h2+, h1 as a badge, links as
+//!   `text url`, padded inline code, 2-column document margin.
+//! - B clean: every marker hidden, GitHub-like. Level bullets, boxed tables and
+//!   code blocks, GitHub alerts, rules under h1/h2.
+//! - C dimmed: every source character kept, markers dimmed, content styled.
+//!
+//! Diff rows keep one row per source line (the AnnotatedLine invariant). The PR
+//! panel reflows paragraphs.
+
+use std::cell::RefCell;
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::ops::Range;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+use pulldown_cmark::{
+    Alignment, BlockQuoteKind, CodeBlockKind, Event, LinkType, Options, Parser, Tag, TagEnd,
+};
+use ratatui::style::{Color, Modifier, Style};
+use ratatui::text::{Line, Span};
+use syntect::highlighting::Highlighter;
+use syntect::parsing::Scope;
+use unicode_width::UnicodeWidthStr;
+
+use super::SyntaxHighlighter;
+use crate::model::{DiffFile, LineOrigin};
+use crate::theme::Theme;
+
+type Runs = Vec<(Style, String)>;
+
+/// Width of rules, fences, and table edges in diff rows, where the row has no
+/// known width at build time.
+const LINE_MODE_RULE_WIDTH: usize = 40;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Variant {
+    Off = 0,
+    Glow = 1,
+    Clean = 2,
+    Dimmed = 3,
+}
+
+const UNSET: u8 = u8::MAX;
+static VARIANT: AtomicU8 = AtomicU8::new(UNSET);
+
+impl Variant {
+    fn from_u8(v: u8) -> Self {
+        match v {
+            1 => Variant::Glow,
+            2 => Variant::Clean,
+            3 => Variant::Dimmed,
+            _ => Variant::Off,
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Variant::Off => "off (today's highlighted source)",
+            Variant::Glow => "A glow",
+            Variant::Clean => "B clean",
+            Variant::Dimmed => "C dimmed source",
+        }
+    }
+}
+
+pub fn variant() -> Variant {
+    let v = VARIANT.load(Ordering::Relaxed);
+    if v != UNSET {
+        return Variant::from_u8(v);
+    }
+    let init = match std::env::var("TUICR_MD_PROTO")
+        .unwrap_or_default()
+        .to_ascii_lowercase()
+        .as_str()
+    {
+        "off" => Variant::Off,
+        "b" | "clean" => Variant::Clean,
+        "c" | "dimmed" => Variant::Dimmed,
+        _ => Variant::Glow,
+    };
+    VARIANT.store(init as u8, Ordering::Relaxed);
+    init
+}
+
+pub fn cycle() -> Variant {
+    let next = Variant::from_u8((variant() as u8 + 1) % 4);
+    VARIANT.store(next as u8, Ordering::Relaxed);
+    next
+}
+
+struct Look {
+    base: Style,
+    marker: Style,
+    /// Heading styles, h1 through h6.
+    headings: [Style; 6],
+    code: Style,
+    code_block: Style,
+    link_text: Style,
+    link_url: Style,
+    image: Style,
+    image_text: Style,
+    quote_bar: Style,
+    quote_text: Style,
+    bullet: Style,
+    border: Style,
+    html: Style,
+}
+
+impl Look {
+    fn new(theme: &Theme, variant: Variant) -> Self {
+        let dim = Style::default().fg(theme.fg_dim);
+        if variant == Variant::Glow {
+            // glamour's dark.json, 256-colour palette.
+            let c = Color::Indexed;
+            let heading = Style::default().fg(c(39)).add_modifier(Modifier::BOLD);
+            return Self {
+                base: Style::default().fg(c(252)),
+                marker: dim,
+                headings: [
+                    Style::default()
+                        .fg(c(228))
+                        .bg(c(63))
+                        .add_modifier(Modifier::BOLD),
+                    heading,
+                    heading,
+                    heading,
+                    heading,
+                    Style::default().fg(c(35)),
+                ],
+                code: Style::default().fg(c(203)).bg(c(236)),
+                code_block: Style::default().fg(c(244)),
+                link_text: Style::default().fg(c(35)).add_modifier(Modifier::BOLD),
+                link_url: Style::default()
+                    .fg(c(30))
+                    .add_modifier(Modifier::UNDERLINED),
+                image: Style::default()
+                    .fg(c(212))
+                    .add_modifier(Modifier::UNDERLINED),
+                image_text: Style::default().fg(c(243)),
+                quote_bar: Style::default().fg(c(244)),
+                quote_text: Style::default(),
+                bullet: Style::default().fg(c(252)),
+                border: Style::default().fg(c(240)),
+                html: Style::default().fg(c(244)),
+            };
+        }
+
+        let hl = theme.syntax_highlighter();
+        let highlighter = Highlighter::new(&hl.theme);
+        let scoped = |scopes: &[&str]| -> Style {
+            let stack: Vec<Scope> = scopes.iter().filter_map(|s| Scope::new(s).ok()).collect();
+            SyntaxHighlighter::syntect_to_ratatui_style(highlighter.style_for_stack(&stack))
+        };
+        const ROOT: &str = "text.html.markdown";
+        let heading = scoped(&[
+            ROOT,
+            "markup.heading.markdown",
+            "entity.name.section.markdown",
+        ]);
+        let link = scoped(&[
+            ROOT,
+            "meta.link.inline.markdown",
+            "markup.underline.link.markdown",
+        ]);
+        let quote = scoped(&[ROOT, "markup.quote.markdown"]);
+        Self {
+            base: scoped(&[ROOT]),
+            marker: dim,
+            // Themes often bold headings already, so each level states both
+            // bold and underline explicitly. h1/h2 underline spans the panel.
+            headings: {
+                let plain = heading.remove_modifier(Modifier::BOLD | Modifier::UNDERLINED);
+                [
+                    plain.add_modifier(Modifier::BOLD | Modifier::UNDERLINED),
+                    plain.add_modifier(Modifier::UNDERLINED),
+                    plain.add_modifier(Modifier::BOLD),
+                    plain.add_modifier(Modifier::UNDERLINED),
+                    plain.add_modifier(Modifier::ITALIC),
+                    Style::default()
+                        .fg(theme.fg_dim)
+                        .add_modifier(Modifier::ITALIC),
+                ]
+            },
+            // glamour's inline code chip: muted salmon on dark gray.
+            code: Style::default()
+                .fg(Color::Indexed(203))
+                .bg(Color::Indexed(236)),
+            code_block: Style::default().fg(theme.fg_secondary),
+            link_text: link.add_modifier(Modifier::UNDERLINED),
+            link_url: dim,
+            image: link,
+            image_text: link,
+            quote_bar: quote,
+            quote_text: quote.add_modifier(Modifier::ITALIC),
+            bullet: scoped(&[ROOT, "markup.list.unnumbered.markdown"]),
+            border: dim,
+            html: dim,
+        }
+    }
+}
+
+fn alert_style(kind: BlockQuoteKind) -> (Style, &'static str) {
+    let (color, label) = match kind {
+        BlockQuoteKind::Note => (Color::Blue, "ℹ Note"),
+        BlockQuoteKind::Tip => (Color::Green, "💡 Tip"),
+        BlockQuoteKind::Important => (Color::Magenta, "❗ Important"),
+        BlockQuoteKind::Warning => (Color::Yellow, "⚠ Warning"),
+        BlockQuoteKind::Caution => (Color::Red, "⛔ Caution"),
+    };
+    (
+        Style::default().fg(color).add_modifier(Modifier::BOLD),
+        label,
+    )
+}
+
+struct LinkCtx {
+    start: usize,
+    children_end: usize,
+    is_image: bool,
+    dest: String,
+    link_type: LinkType,
+}
+
+struct TableCtx {
+    aligns: Vec<Alignment>,
+    range: Range<usize>,
+    rows: Vec<(bool, Vec<Range<usize>>)>,
+}
+
+struct Doc<'a> {
+    src: &'a str,
+    variant: Variant,
+    look: Look,
+    rule_width: usize,
+    styles: Vec<Style>,
+    repl: BTreeMap<usize, (usize, Runs)>,
+    inserts: BTreeMap<usize, Runs>,
+    line_starts: Vec<usize>,
+    overrides: HashMap<usize, Runs>,
+    prefixes: HashMap<usize, Runs>,
+    no_reflow: Vec<bool>,
+    /// Building for the reflowing PR panel rather than 1:1 diff rows.
+    block: bool,
+    /// Source lines the PR panel drops (fences, table delimiter rows).
+    skip: HashSet<usize>,
+    /// Heading level by source line.
+    headings: HashMap<usize, usize>,
+    /// Right-aligned tag on a line's first row in the PR panel (code language).
+    labels: HashMap<usize, Runs>,
+}
+
+impl<'a> Doc<'a> {
+    fn build(
+        theme: &Theme,
+        src: &'a str,
+        variant: Variant,
+        rule_width: usize,
+        block: bool,
+    ) -> Self {
+        let look = Look::new(theme, variant);
+        let mut line_starts = vec![0];
+        line_starts.extend(src.match_indices('\n').map(|(i, _)| i + 1));
+        let n = line_starts.len();
+        let mut doc = Self {
+            src,
+            variant,
+            styles: vec![look.base; src.len()],
+            look,
+            rule_width,
+            repl: BTreeMap::new(),
+            inserts: BTreeMap::new(),
+            line_starts,
+            overrides: HashMap::new(),
+            prefixes: HashMap::new(),
+            no_reflow: vec![false; n],
+            block,
+            skip: HashSet::new(),
+            headings: HashMap::new(),
+            labels: HashMap::new(),
+        };
+        doc.walk(theme);
+        doc
+    }
+
+    fn line_of(&self, byte: usize) -> usize {
+        match self.line_starts.binary_search(&byte) {
+            Ok(i) => i,
+            Err(i) => i - 1,
+        }
+    }
+
+    fn line_range(&self, line: usize) -> Range<usize> {
+        let start = self.line_starts[line];
+        let end = self
+            .line_starts
+            .get(line + 1)
+            .map(|s| s - 1)
+            .unwrap_or(self.src.len());
+        start..end
+    }
+
+    fn lines_of(&self, r: &Range<usize>) -> std::ops::RangeInclusive<usize> {
+        let first = self.line_of(r.start);
+        let last = self.line_of(r.end.saturating_sub(1).max(r.start));
+        first..=last
+    }
+
+    fn paint(&mut self, r: Range<usize>, style: Style) {
+        let end = r.end.min(self.src.len());
+        if let Some(slots) = self.styles.get_mut(r.start..end) {
+            for slot in slots {
+                *slot = slot.patch(style);
+            }
+        }
+    }
+
+    fn replace(&mut self, r: Range<usize>, runs: Runs) {
+        if r.start < r.end {
+            self.repl.entry(r.start).or_insert((r.end, runs));
+        }
+    }
+
+    /// A syntax marker: dimmed in C, replaced (or hidden) otherwise.
+    fn marker(&mut self, r: Range<usize>, runs: Runs) {
+        if self.variant == Variant::Dimmed {
+            let style = self.look.marker;
+            self.paint(r, style);
+        } else {
+            self.replace(r, runs);
+        }
+    }
+
+    fn count(&self, at: usize, ch: char) -> usize {
+        self.src[at..].chars().take_while(|c| *c == ch).count() * ch.len_utf8()
+    }
+
+    fn walk(&mut self, theme: &Theme) {
+        let hl = theme.syntax_highlighter();
+        let src = self.src;
+        let mut opts = Options::empty();
+        opts.insert(Options::ENABLE_STRIKETHROUGH);
+        opts.insert(Options::ENABLE_TABLES);
+        opts.insert(Options::ENABLE_TASKLISTS);
+        opts.insert(Options::ENABLE_GFM);
+
+        let mut links: Vec<LinkCtx> = Vec::new();
+        let mut list_depth = 0usize;
+        let mut code: Option<syntect::easy::HighlightLines> = None;
+        let mut table: Option<TableCtx> = None;
+
+        for (event, r) in Parser::new_ext(src, opts).into_offset_iter() {
+            let is_link_edge = matches!(
+                event,
+                Event::Start(Tag::Link { .. } | Tag::Image { .. })
+                    | Event::End(TagEnd::Link | TagEnd::Image)
+            );
+            if !is_link_edge {
+                for l in links.iter_mut() {
+                    l.children_end = l.children_end.max(r.end);
+                }
+            }
+
+            match event {
+                Event::Start(Tag::Heading { level, .. }) => self.heading(level as usize, r),
+                Event::Start(Tag::Strong) => {
+                    self.paint(r.clone(), Style::new().add_modifier(Modifier::BOLD));
+                    self.delimiters(r, 2);
+                }
+                Event::Start(Tag::Emphasis) => {
+                    self.paint(r.clone(), Style::new().add_modifier(Modifier::ITALIC));
+                    self.delimiters(r, 1);
+                }
+                Event::Start(Tag::Strikethrough) => {
+                    self.paint(r.clone(), Style::new().add_modifier(Modifier::CROSSED_OUT));
+                    let n = self.count(r.start, '~');
+                    self.delimiters(r, n);
+                }
+                Event::Code(_) => {
+                    let n = self.count(r.start, '`');
+                    let code_style = self.look.code;
+                    self.paint(r.start + n..r.end.saturating_sub(n), code_style);
+                    let pad = if matches!(self.variant, Variant::Glow | Variant::Clean) {
+                        vec![(code_style, " ".to_string())]
+                    } else {
+                        vec![]
+                    };
+                    self.marker(r.start..r.start + n, pad.clone());
+                    self.marker(r.end.saturating_sub(n)..r.end, pad);
+                }
+                Event::Start(Tag::Link {
+                    link_type,
+                    dest_url,
+                    ..
+                }) => links.push(LinkCtx {
+                    start: r.start,
+                    children_end: r.start + 1,
+                    is_image: false,
+                    dest: dest_url.to_string(),
+                    link_type,
+                }),
+                Event::Start(Tag::Image {
+                    link_type,
+                    dest_url,
+                    ..
+                }) => links.push(LinkCtx {
+                    start: r.start,
+                    children_end: r.start + 2,
+                    is_image: true,
+                    dest: dest_url.to_string(),
+                    link_type,
+                }),
+                Event::End(TagEnd::Link | TagEnd::Image) => {
+                    if let Some(ctx) = links.pop() {
+                        self.link(ctx, r);
+                    }
+                }
+                Event::Start(Tag::List(_)) => list_depth += 1,
+                Event::End(TagEnd::List(_)) => list_depth = list_depth.saturating_sub(1),
+                Event::Start(Tag::Item) => self.item(r, list_depth),
+                Event::TaskListMarker(checked) => {
+                    let runs = match (self.variant, checked) {
+                        (Variant::Glow, true) => vec![(self.look.bullet, "[✓]".to_string())],
+                        (Variant::Glow, false) => vec![(self.look.bullet, "[ ]".to_string())],
+                        (_, true) => vec![(Style::default().fg(Color::Green), "☑".to_string())],
+                        (_, false) => vec![(self.look.bullet, "☐".to_string())],
+                    };
+                    self.marker(r, runs);
+                }
+                Event::Start(Tag::BlockQuote(kind)) => self.quote(r, kind),
+                Event::Start(Tag::CodeBlock(kind)) => {
+                    let lang = match &kind {
+                        CodeBlockKind::Fenced(lang) => {
+                            lang.split_whitespace().next().unwrap_or("").to_string()
+                        }
+                        CodeBlockKind::Indented => String::new(),
+                    };
+                    code = (!lang.is_empty())
+                        .then(|| hl.syntax_set.find_syntax_by_token(&lang))
+                        .flatten()
+                        .map(|syntax| syntect::easy::HighlightLines::new(syntax, &hl.theme));
+                    self.code_block(r, matches!(kind, CodeBlockKind::Fenced(_)), &lang);
+                }
+                Event::End(TagEnd::CodeBlock) => code = None,
+                Event::Text(text) => {
+                    let Some(block) = code.as_mut() else {
+                        continue;
+                    };
+                    let Ok(runs) = block.highlight_line(&text, &hl.syntax_set) else {
+                        continue;
+                    };
+                    let mut at = r.start;
+                    for (style, piece) in runs {
+                        let style = SyntaxHighlighter::syntect_to_ratatui_style(style);
+                        self.paint(at..at + piece.len(), style);
+                        at += piece.len();
+                    }
+                }
+                Event::Rule => {
+                    let line = self.line_of(r.start);
+                    self.no_reflow[line] = true;
+                    let border = self.look.border;
+                    match self.variant {
+                        Variant::Glow => {
+                            self.overrides
+                                .insert(line, vec![(border, "--------".to_string())]);
+                        }
+                        Variant::Clean => {
+                            self.overrides
+                                .insert(line, vec![(border, "─".repeat(self.rule_width))]);
+                        }
+                        _ => self.paint(r, self.look.marker),
+                    }
+                }
+                Event::Html(_) | Event::InlineHtml(_) => {
+                    let html = self.look.html;
+                    self.paint(r, html);
+                }
+                Event::Start(Tag::HtmlBlock) => {
+                    for line in self.lines_of(&r) {
+                        self.no_reflow[line] = true;
+                    }
+                }
+                Event::Start(Tag::Table(aligns)) => {
+                    table = Some(TableCtx {
+                        aligns,
+                        range: r,
+                        rows: Vec::new(),
+                    })
+                }
+                Event::Start(Tag::TableHead) => {
+                    if let Some(t) = table.as_mut() {
+                        t.rows.push((true, Vec::new()));
+                    }
+                }
+                Event::Start(Tag::TableRow) => {
+                    if let Some(t) = table.as_mut() {
+                        t.rows.push((false, Vec::new()));
+                    }
+                }
+                Event::Start(Tag::TableCell) => {
+                    if let Some((_, cells)) = table.as_mut().and_then(|t| t.rows.last_mut()) {
+                        cells.push(r);
+                    }
+                }
+                Event::End(TagEnd::Table) => {
+                    if let Some(t) = table.take() {
+                        self.table(t);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+
+    fn delimiters(&mut self, r: Range<usize>, n: usize) {
+        if n == 0 || r.end < r.start + 2 * n {
+            return;
+        }
+        self.marker(r.start..r.start + n, vec![]);
+        self.marker(r.end - n..r.end, vec![]);
+    }
+
+    fn heading(&mut self, level: usize, r: Range<usize>) {
+        let style = self.look.headings[level.clamp(1, 6) - 1];
+        let first = self.line_of(r.start);
+        self.no_reflow[first] = true;
+        self.headings.insert(first, level);
+        if !self.src[r.start..].starts_with('#') {
+            // Setext heading: text line(s), then an `===`/`---` underline.
+            let last = self.line_of(r.end.saturating_sub(1));
+            let text = self.line_range(first);
+            self.paint(text, style);
+            if last > first {
+                self.no_reflow[last] = true;
+                match self.variant {
+                    Variant::Dimmed => self.paint(self.line_range(last), self.look.marker),
+                    _ => {
+                        self.overrides.insert(last, vec![]);
+                    }
+                }
+            }
+            return;
+        }
+        let hashes = self.count(r.start, '#');
+        let marker_end = r.start + hashes + self.count(r.start + hashes, ' ');
+        let line_end = self.line_range(first).end.min(r.end);
+        let content_end = r.start + self.src[r.start..line_end].trim_end().len();
+        self.paint(marker_end..content_end, style);
+        match self.variant {
+            Variant::Glow if level == 1 => {
+                self.replace(r.start..marker_end, vec![(style, " ".to_string())]);
+                self.inserts
+                    .insert(content_end, vec![(style, " ".to_string())]);
+            }
+            Variant::Glow => {
+                self.replace(
+                    r.start..marker_end,
+                    vec![(style, format!("{} ", "#".repeat(level)))],
+                );
+            }
+            Variant::Clean => self.replace(r.start..marker_end, vec![]),
+            _ => self.paint(r.start..marker_end, self.look.marker),
+        }
+    }
+
+    fn link(&mut self, ctx: LinkCtx, r: Range<usize>) {
+        let r = ctx.start..r.end;
+        if matches!(ctx.link_type, LinkType::Autolink | LinkType::Email) {
+            self.paint(r.clone(), self.look.link_text);
+            self.marker(r.start..r.start + 1, vec![]);
+            self.marker(r.end - 1..r.end, vec![]);
+            return;
+        }
+        let open = if ctx.is_image { 2 } else { 1 };
+        let text = r.start + open..ctx.children_end.max(r.start + open).min(r.end);
+        let tail = text.end..r.end;
+        let look = &self.look;
+        let (text_style, open_runs, tail_runs) = match (ctx.is_image, self.variant) {
+            (true, Variant::Glow) => (
+                look.image_text,
+                vec![(look.image_text, "Image: ".to_string())],
+                vec![
+                    (look.image_text, " → ".to_string()),
+                    (look.image, ctx.dest.clone()),
+                ],
+            ),
+            (true, _) => (
+                look.image_text,
+                vec![(look.image, "▣ ".to_string())],
+                vec![],
+            ),
+            (false, Variant::Glow) => (
+                look.link_text,
+                vec![],
+                vec![
+                    (look.base, " ".to_string()),
+                    (look.link_url, ctx.dest.clone()),
+                ],
+            ),
+            (false, _) => (look.link_text, vec![], vec![]),
+        };
+        self.paint(text, text_style);
+        self.marker(r.start..r.start + open, open_runs);
+        self.marker(tail, tail_runs);
+    }
+
+    fn item(&mut self, r: Range<usize>, depth: usize) {
+        let start = r.start + self.count(r.start, ' ');
+        let Some(ch) = self.src[start..].chars().next() else {
+            return;
+        };
+        let bullet = self.look.bullet;
+        if matches!(ch, '-' | '*' | '+') {
+            let glyph = match self.variant {
+                Variant::Glow => "•",
+                _ => ["•", "◦", "▪"][depth.saturating_sub(1) % 3],
+            };
+            self.marker(start..start + 1, vec![(bullet, glyph.to_string())]);
+        } else {
+            let digits = self.src[start..]
+                .chars()
+                .take_while(|c| c.is_ascii_digit())
+                .count();
+            let end = (start + digits + 1).min(self.src.len());
+            let style = if self.variant == Variant::Dimmed {
+                self.look.marker
+            } else {
+                bullet
+            };
+            self.paint(start..end, style);
+        }
+    }
+
+    fn quote(&mut self, r: Range<usize>, kind: Option<BlockQuoteKind>) {
+        let alert = kind.map(alert_style);
+        let bar_style = alert.map(|(s, _)| s).unwrap_or(self.look.quote_bar);
+        let (bar, text_style) = match self.variant {
+            Variant::Glow => ("│", self.look.quote_text),
+            _ => ("▎", self.look.quote_text),
+        };
+        self.paint(r.clone(), text_style);
+        for line in self.lines_of(&r) {
+            let lr = self.line_range(line);
+            for (i, ch) in self.src[lr.clone()].char_indices() {
+                match ch {
+                    '>' => {
+                        let at = lr.start + i;
+                        self.marker(at..at + 1, vec![(bar_style, bar.to_string())]);
+                    }
+                    ' ' => {}
+                    _ => break,
+                }
+            }
+        }
+        if let Some((style, label)) = alert
+            && self.variant != Variant::Glow
+            && let Some(open) = self.src[r.clone()].find("[!")
+            && let Some(close) = self.src[r.start + open..r.end].find(']')
+        {
+            let tag = r.start + open..r.start + open + close + 1;
+            let tag_line = self.line_of(tag.start);
+            self.no_reflow[tag_line] = true;
+            match self.variant {
+                Variant::Dimmed => self.paint(tag, style),
+                _ => self.replace(tag, vec![(style, label.to_string())]),
+            }
+        }
+    }
+
+    fn code_block(&mut self, r: Range<usize>, fenced: bool, lang: &str) {
+        let lines: Vec<usize> = self.lines_of(&r).collect();
+        for &line in &lines {
+            self.no_reflow[line] = true;
+        }
+        if !fenced {
+            return;
+        }
+        let first = lines[0];
+        let fence = self.src[self.line_range(first)].trim_start().chars().next();
+        let last = *lines.last().unwrap_or(&first);
+        let close = (last > first
+            && fence.is_some_and(|f| self.src[self.line_range(last)].trim_start().starts_with(f)))
+        .then_some(last);
+        let content: Vec<usize> = lines
+            .iter()
+            .copied()
+            .filter(|l| *l != first && Some(*l) != close)
+            .collect();
+        let border = self.look.border;
+        match self.variant {
+            Variant::Glow => {
+                self.overrides.insert(first, vec![]);
+                if let Some(close) = close {
+                    self.overrides.insert(close, vec![]);
+                }
+                for &line in &content {
+                    self.prefixes.insert(line, vec![(border, "  ".to_string())]);
+                    if lang.is_empty() {
+                        let range = self.line_range(line);
+                        self.paint(range, self.look.code_block);
+                    }
+                }
+            }
+            Variant::Clean if self.block => {
+                // No fence rows: the gutter marks the block, the language
+                // sits right-aligned on its first row.
+                self.skip.insert(first);
+                if let Some(close) = close {
+                    self.skip.insert(close);
+                }
+                for &line in &content {
+                    self.prefixes.insert(line, vec![(border, "│ ".to_string())]);
+                }
+                if let Some(&top) = content.first()
+                    && !lang.is_empty()
+                {
+                    self.labels.insert(top, vec![(border, lang.to_string())]);
+                }
+            }
+            Variant::Clean => {
+                let label_w = lang.width();
+                let fill = self.rule_width.saturating_sub(label_w + 4);
+                let open = if lang.is_empty() {
+                    vec![(
+                        border,
+                        format!("╭{}", "─".repeat(self.rule_width.saturating_sub(1))),
+                    )]
+                } else {
+                    vec![
+                        (border, "╭─ ".to_string()),
+                        (self.look.headings[2], lang.to_string()),
+                        (border, format!(" {}", "─".repeat(fill))),
+                    ]
+                };
+                self.overrides.insert(first, open);
+                if let Some(close) = close {
+                    self.overrides.insert(
+                        close,
+                        vec![(
+                            border,
+                            format!("╰{}", "─".repeat(self.rule_width.saturating_sub(1))),
+                        )],
+                    );
+                }
+                for &line in &content {
+                    self.prefixes.insert(line, vec![(border, "│ ".to_string())]);
+                }
+            }
+            _ => {
+                let marker = self.look.marker;
+                self.paint(self.line_range(first), marker);
+                if let Some(close) = close {
+                    self.paint(self.line_range(close), marker);
+                }
+            }
+        }
+    }
+
+    fn table(&mut self, t: TableCtx) {
+        for line in self.lines_of(&t.range) {
+            self.no_reflow[line] = true;
+        }
+        let border = self.look.border;
+        if self.variant == Variant::Dimmed {
+            for (i, ch) in self.src[t.range.clone()].char_indices() {
+                if matches!(ch, '|') {
+                    let at = t.range.start + i;
+                    self.paint(at..at + 1, border);
+                }
+            }
+            return;
+        }
+
+        // Cells rendered through the same replacement machinery as prose.
+        let mut rows: Vec<(usize, bool, Vec<Runs>)> = Vec::new();
+        for (is_head, cells) in &t.rows {
+            let Some(first) = cells.first() else { continue };
+            let line = self.line_of(first.start);
+            let rendered = cells
+                .iter()
+                .map(|c| {
+                    let s = &self.src[c.clone()];
+                    let lead = s.len() - s.trim_start_matches([' ', '|']).len();
+                    let trail = s.len() - s.trim_end_matches([' ', '|']).len();
+                    let end = (c.end - trail).max(c.start + lead);
+                    let mut runs = self.emit(c.start + lead, end);
+                    if *is_head {
+                        for (style, _) in &mut runs {
+                            *style = style.add_modifier(Modifier::BOLD);
+                        }
+                    }
+                    runs
+                })
+                .collect();
+            rows.push((line, *is_head, rendered));
+        }
+        let cols = t
+            .aligns
+            .len()
+            .max(rows.iter().map(|r| r.2.len()).max().unwrap_or(0));
+        let mut widths = vec![1usize; cols];
+        for (_, _, cells) in &rows {
+            for (i, cell) in cells.iter().enumerate() {
+                widths[i] = widths[i].max(runs_width(cell));
+            }
+        }
+
+        let clean = self.variant == Variant::Clean;
+        let row_lines: Vec<usize> = rows.iter().map(|r| r.0).collect();
+        let head_last_width = rows
+            .iter()
+            .find(|r| r.1)
+            .and_then(|r| r.2.last())
+            .map(runs_width);
+        // In the PR panel a clean table underlines its header instead of
+        // spending a row on the delimiter.
+        let underline_head = clean && self.block;
+        for (line, is_head, cells) in rows {
+            let bar = (border, "│".to_string());
+            let gap = (self.look.base, " ".to_string());
+            // No outer bars: an underline cannot stop exactly at a bar at the
+            // table's edge, it overshoots by half a cell.
+            let mut out: Runs = Vec::new();
+            for (i, width) in widths.iter().enumerate() {
+                if i > 0 {
+                    out.extend([gap.clone(), bar.clone(), gap.clone()]);
+                }
+                let cell = cells.get(i).cloned().unwrap_or_default();
+                let pad = width.saturating_sub(runs_width(&cell));
+                let (left, right) = match t.aligns.get(i) {
+                    Some(Alignment::Right) => (pad, 0),
+                    Some(Alignment::Center) => (pad / 2, pad - pad / 2),
+                    _ => (0, pad),
+                };
+                out.push((self.look.base, " ".repeat(left)));
+                out.extend(cell);
+                // Trailing pad on the last column only makes rows wrap, except
+                // where it carries the header underline to the table's edge.
+                let last_col = i + 1 == widths.len();
+                if !last_col || (underline_head && is_head) {
+                    out.push((self.look.base, " ".repeat(right)));
+                }
+            }
+            // Underlining the bars too joins the rule to them; the border
+            // colour keeps the rule quieter than the header text.
+            if underline_head && is_head {
+                for (style, _) in out.iter_mut() {
+                    *style = style.add_modifier(Modifier::UNDERLINED);
+                    if let Some(color) = border.fg {
+                        *style = style.underline_color(color);
+                    }
+                }
+            }
+            self.overrides.insert(line, out);
+        }
+        // The last column is sized by its widest cell, often long prose; a
+        // separator that wide wraps. It spans only the header cell instead.
+        let segs: Vec<String> = widths
+            .iter()
+            .enumerate()
+            .map(|(i, w)| {
+                let w = match head_last_width {
+                    Some(head) if i + 1 == widths.len() => head.max(3).min(*w),
+                    _ => *w,
+                };
+                "─".repeat(w)
+            })
+            .collect();
+        let delim = segs.join("─┼─");
+        for line in self.lines_of(&t.range) {
+            if row_lines.contains(&line) {
+                continue;
+            }
+            if underline_head {
+                self.skip.insert(line);
+            } else {
+                self.overrides.insert(line, vec![(border, delim.clone())]);
+            }
+        }
+    }
+
+    fn emit(&self, a: usize, b: usize) -> Runs {
+        let mut out: Runs = Vec::new();
+        let mut p = a;
+        while p < b {
+            if let Some(ins) = self.inserts.get(&p) {
+                out.extend(ins.iter().cloned());
+            }
+            if let Some((end, runs)) = self.repl.get(&p) {
+                out.extend(runs.iter().cloned());
+                p = (*end).max(p + 1);
+                continue;
+            }
+            let Some(ch) = self.src[p..].chars().next() else {
+                break;
+            };
+            push_char(&mut out, self.styles[p], ch);
+            p += ch.len_utf8();
+        }
+        if let Some(ins) = self.inserts.get(&b) {
+            out.extend(ins.iter().cloned());
+        }
+        out
+    }
+
+    fn render_line(&self, line: usize) -> Runs {
+        if let Some(o) = self.overrides.get(&line) {
+            return o.clone();
+        }
+        let r = self.line_range(line);
+        let mut out = self.prefixes.get(&line).cloned().unwrap_or_default();
+        out.extend(self.emit(r.start, r.end));
+        out
+    }
+
+    /// Byte where a line's prose starts: past indentation, quote bars, a list
+    /// marker, and a task box.
+    fn content_start(&self, line: usize, skip_list_marker: bool) -> usize {
+        let r = self.line_range(line);
+        let s = &self.src[r.clone()];
+        let mut i = s.len() - s.trim_start_matches([' ', '>']).len();
+        if skip_list_marker {
+            let rest = &s[i..];
+            let marker =
+                if rest.starts_with("- ") || rest.starts_with("* ") || rest.starts_with("+ ") {
+                    2
+                } else {
+                    let digits = rest.chars().take_while(|c| c.is_ascii_digit()).count();
+                    if digits > 0
+                        && (rest[digits..].starts_with(". ") || rest[digits..].starts_with(") "))
+                    {
+                        digits + 2
+                    } else {
+                        0
+                    }
+                };
+            i += marker;
+            let rest = &s[i..];
+            if rest.starts_with("[ ] ") || rest.starts_with("[x] ") || rest.starts_with("[X] ") {
+                i += 4;
+            }
+        }
+        r.start + i
+    }
+
+    fn starts_block(&self, line: usize) -> bool {
+        let s = self.src[self.line_range(line)].trim_start_matches([' ', '>']);
+        let digits = s.chars().take_while(|c| c.is_ascii_digit()).count();
+        s.is_empty()
+            || s.starts_with("- ")
+            || s.starts_with("* ")
+            || s.starts_with("+ ")
+            || s.starts_with('#')
+            || s.starts_with('|')
+            || s.starts_with("```")
+            || s.starts_with("~~~")
+            || (digits > 0 && (s[digits..].starts_with(". ") || s[digits..].starts_with(") ")))
+    }
+
+    fn hard_break(&self, line: usize) -> bool {
+        let s = &self.src[self.line_range(line)];
+        s.ends_with("  ") || s.ends_with('\\') || s.trim().is_empty()
+    }
+}
+
+fn push_char(out: &mut Runs, style: Style, ch: char) {
+    match out.last_mut() {
+        Some((prev, text)) if *prev == style => text.push(ch),
+        _ => out.push((style, ch.to_string())),
+    }
+}
+
+fn runs_width(runs: &Runs) -> usize {
+    runs.iter().map(|(_, t)| t.width()).sum()
+}
+
+/// Word-wrap styled runs to `width`, indenting continuation rows with `cont`.
+fn wrap(runs: &Runs, width: usize, cont: &Runs) -> Vec<Runs> {
+    let width = width.max(1);
+    let cont: Runs = if runs_width(cont) * 2 > width {
+        vec![]
+    } else {
+        cont.clone()
+    };
+    let cont_w = runs_width(&cont);
+    // Words span style changes (`~~gone~~.` is one word), so tokens are runs.
+    let mut tokens: Vec<(bool, Runs)> = Vec::new();
+    for (style, text) in runs {
+        for ch in text.chars() {
+            let space = ch == ' ';
+            match tokens.last_mut() {
+                Some((s, tok)) if *s == space => push_char(tok, *style, ch),
+                _ => tokens.push((space, vec![(*style, ch.to_string())])),
+            }
+        }
+    }
+
+    let mut rows: Vec<Runs> = Vec::new();
+    let mut row: Runs = Vec::new();
+    let mut row_w = 0usize;
+    let mut row_base = 0usize;
+    for (is_space, tok) in tokens {
+        let w = runs_width(&tok);
+        if row_w + w > width && row_w > row_base {
+            rows.push(std::mem::take(&mut row));
+            row = cont.clone();
+            row_w = cont_w;
+            row_base = cont_w;
+            if is_space {
+                continue;
+            }
+        }
+        if row_w + w <= width {
+            for (style, text) in &tok {
+                push_str(&mut row, *style, text);
+            }
+            row_w += w;
+            continue;
+        }
+        // A single word wider than the row: hard-split it.
+        for (style, text) in tok {
+            for ch in text.chars() {
+                let cw = unicode_width::UnicodeWidthChar::width(ch).unwrap_or(0);
+                if row_w + cw > width && row_w > row_base {
+                    rows.push(std::mem::take(&mut row));
+                    row = cont.clone();
+                    row_w = cont_w;
+                    row_base = cont_w;
+                }
+                push_char(&mut row, style, ch);
+                row_w += cw;
+            }
+        }
+    }
+    rows.push(row);
+    rows
+}
+
+fn push_str(out: &mut Runs, style: Style, s: &str) {
+    match out.last_mut() {
+        Some((prev, text)) if *prev == style => text.push_str(s),
+        _ => out.push((style, s.to_string())),
+    }
+}
+
+/// Orca's terminal draws an underline white after SGR 59 (reset underline
+/// colour), which ratatui sends at the end of every frame. Pinning the
+/// underline colour to the text colour sidesteps it.
+fn pin_underline(style: Style) -> Style {
+    match style.fg {
+        Some(fg)
+            if style.add_modifier.contains(Modifier::UNDERLINED)
+                && style.underline_color.is_none() =>
+        {
+            style.underline_color(fg)
+        }
+        _ => style,
+    }
+}
+
+fn to_line(runs: Runs) -> Line<'static> {
+    Line::from(
+        runs.into_iter()
+            .map(|(style, text)| Span::styled(text, pin_underline(style)))
+            .collect::<Vec<_>>(),
+    )
+}
+
+/// One rendered row per source line, for diff rows.
+pub fn render_lines(theme: &Theme, lines: &[&str], variant: Variant) -> Vec<Runs> {
+    let src = lines.join("\n");
+    let doc = Doc::build(theme, &src, variant, LINE_MODE_RULE_WIDTH, false);
+    (0..lines.len())
+        .map(|i| {
+            doc.render_line(i)
+                .into_iter()
+                .map(|(style, text)| (pin_underline(style), text))
+                .collect()
+        })
+        .collect()
+}
+
+/// Reflowed rows for the PR description panel.
+pub fn render_block(
+    theme: &Theme,
+    content: &str,
+    width: usize,
+    variant: Variant,
+) -> Vec<Line<'static>> {
+    let margin = if variant == Variant::Glow { 2 } else { 0 };
+    let inner = width.saturating_sub(margin).max(1);
+    let doc = Doc::build(theme, content, variant, inner, true);
+    let n = doc.line_starts.len();
+    let mut out: Vec<Line<'static>> = Vec::new();
+    let push = |out: &mut Vec<Line<'static>>, mut line: Line<'static>| {
+        if margin > 0 {
+            line.spans.insert(0, Span::raw(" ".repeat(margin)));
+        }
+        out.push(line);
+    };
+
+    // Clean collapses runs of blank rows to one.
+    let compact = variant == Variant::Clean;
+    let mut prev_blank = true;
+    let mut i = 0;
+    while i < n {
+        if doc.skip.contains(&i) {
+            i += 1;
+            continue;
+        }
+        let blank = !doc.no_reflow[i]
+            && !doc.overrides.contains_key(&i)
+            && doc.src[doc.line_range(i)].trim().is_empty();
+        if compact && blank && prev_blank {
+            i += 1;
+            continue;
+        }
+        prev_blank = blank;
+        let mut logical = doc.render_line(i);
+        let reflow = variant != Variant::Dimmed && !doc.no_reflow[i];
+        let lead_end = doc.content_start(i, true);
+        let mut lead = doc.prefixes.get(&i).cloned().unwrap_or_default();
+        lead.extend(doc.emit(doc.line_range(i).start, lead_end));
+        let cont: Runs = lead
+            .iter()
+            .map(|(style, text)| {
+                let kept: String = text
+                    .chars()
+                    .map(|c| if matches!(c, '│' | '▎') { c } else { ' ' })
+                    .collect();
+                (*style, kept)
+            })
+            .collect();
+        let mut last = i;
+        if reflow {
+            while last + 1 < n
+                && !doc.no_reflow[last + 1]
+                && !doc.overrides.contains_key(&(last + 1))
+                && !doc.starts_block(last + 1)
+                && !doc.hard_break(last)
+            {
+                last += 1;
+                push_str(&mut logical, doc.look.base, " ");
+                logical.extend(doc.emit(doc.content_start(last, false), doc.line_range(last).end));
+            }
+        }
+        let mut rows = wrap(&logical, inner, &cont);
+        if let (Some(label), Some(first)) = (doc.labels.get(&i), rows.first_mut()) {
+            let gap = inner.saturating_sub(runs_width(first) + runs_width(label));
+            if gap > 0 {
+                first.push((doc.look.base, " ".repeat(gap)));
+                first.extend(label.iter().cloned());
+            }
+        }
+        // Clean h1/h2 carry their underline across the panel.
+        if compact
+            && doc.headings.get(&i).is_some_and(|level| *level <= 2)
+            && let Some(row) = rows.last_mut()
+        {
+            let style = row.last().map(|(s, _)| *s).unwrap_or(doc.look.headings[0]);
+            let gap = inner.saturating_sub(runs_width(row));
+            row.push((style, " ".repeat(gap)));
+        }
+        for row in rows {
+            push(&mut out, to_line(row));
+        }
+        i = last + 1;
+    }
+    out
+}
+
+thread_local! {
+    /// The syntect spans each `.md` diff line had before the prototype touched
+    /// it, so `off` restores them. Keyed by file content hash, hunk, line.
+    static ORIGINALS: RefCell<HashMap<(u64, usize, usize), Option<Runs>>> = RefCell::new(HashMap::new());
+}
+
+fn is_markdown(file: &DiffFile) -> bool {
+    file.new_path
+        .as_ref()
+        .or(file.old_path.as_ref())
+        .and_then(|p| p.extension())
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| matches!(e.to_ascii_lowercase().as_str(), "md" | "markdown"))
+}
+
+thread_local! {
+    /// Full new-side text per `.md` file, keyed by content hash, so a forge
+    /// fetch happens once per file rather than once per annotation rebuild.
+    static FULL_TEXT: RefCell<HashMap<u64, Vec<String>>> = RefCell::new(HashMap::new());
+}
+
+/// Fetch a `.md` file's full new-side text, the way gap expansion does.
+pub fn full_new_text(
+    file: &DiffFile,
+    provider: &dyn crate::forge::context::ContextProvider,
+) -> Option<Vec<String>> {
+    if file.is_commit_message
+        || !is_markdown(file)
+        || file.status == crate::model::FileStatus::Deleted
+    {
+        return None;
+    }
+    if let Some(hit) = FULL_TEXT.with(|c| c.borrow().get(&file.content_hash).cloned()) {
+        return Some(hit);
+    }
+    // Only successes are cached: in PR mode the first rebuild runs before the
+    // forge provider is attached, and that fetch fails.
+    let (old, new) = (file.old_path.as_ref(), file.new_path.as_ref());
+    let count = provider.file_line_count(old, new, file.status).ok()?;
+    if count == 0 {
+        return None;
+    }
+    let lines: Vec<String> = provider
+        .fetch_context_lines(old, new, file.status, 1, count)
+        .ok()?
+        .into_iter()
+        .map(|l| l.content)
+        .collect();
+    FULL_TEXT.with(|c| c.borrow_mut().insert(file.content_hash, lines.clone()));
+    Some(lines)
+}
+
+/// The old file, rebuilt from the new file plus the hunks.
+fn reconstruct_old(new: &[String], file: &DiffFile) -> Vec<String> {
+    let mut old = Vec::new();
+    let mut next_new = 1usize;
+    for hunk in &file.hunks {
+        let start = (hunk.new_start as usize).max(1);
+        while next_new < start && next_new <= new.len() {
+            old.push(new[next_new - 1].clone());
+            next_new += 1;
+        }
+        for dl in &hunk.lines {
+            if dl.origin != LineOrigin::Addition {
+                old.push(dl.content.clone());
+            }
+        }
+        next_new = hunk.new_start as usize + hunk.new_count as usize;
+    }
+    while next_new >= 1 && next_new <= new.len() {
+        old.push(new[next_new - 1].clone());
+        next_new += 1;
+    }
+    old
+}
+
+/// Swap `.md` diff rows' spans for the active variant's rendering. With the
+/// full file in `full_new` (index-parallel with `files`), each side renders as
+/// the whole document; without it, each hunk renders as two mini-documents,
+/// so constructs opened above the hunk (a table header, a fence) render wrong.
+pub fn apply_to_diff(theme: &Theme, files: &mut [DiffFile], full_new: &[Option<Vec<String>>]) {
+    let v = variant();
+    for (fi, file) in files.iter_mut().enumerate() {
+        if file.is_commit_message || !is_markdown(file) {
+            continue;
+        }
+        let hash = file.content_hash;
+        ORIGINALS.with(|o| {
+            let mut o = o.borrow_mut();
+            for (hi, hunk) in file.hunks.iter_mut().enumerate() {
+                for (li, dl) in hunk.lines.iter_mut().enumerate() {
+                    let orig = o
+                        .entry((hash, hi, li))
+                        .or_insert_with(|| dl.highlighted_spans.clone());
+                    if v == Variant::Off {
+                        dl.highlighted_spans = orig.clone();
+                    }
+                }
+            }
+        });
+        if v == Variant::Off {
+            continue;
+        }
+        if let Some(Some(new)) = full_new.get(fi) {
+            let old = reconstruct_old(new, file);
+            let new_refs: Vec<&str> = new.iter().map(String::as_str).collect();
+            let old_refs: Vec<&str> = old.iter().map(String::as_str).collect();
+            let new_r = render_lines(theme, &new_refs, v);
+            let old_r = render_lines(theme, &old_refs, v);
+            for hunk in &mut file.hunks {
+                for dl in &mut hunk.lines {
+                    let rendered = match dl.origin {
+                        LineOrigin::Deletion => {
+                            dl.old_lineno.and_then(|n| old_r.get(n as usize - 1))
+                        }
+                        _ => dl.new_lineno.and_then(|n| new_r.get(n as usize - 1)),
+                    };
+                    if let Some(r) = rendered {
+                        dl.highlighted_spans = Some(r.clone());
+                    }
+                }
+            }
+            continue;
+        }
+        for hunk in &mut file.hunks {
+            for side in [LineOrigin::Deletion, LineOrigin::Addition] {
+                // Deletion pass renders the old side; Addition pass the new side.
+                let idx: Vec<usize> = hunk
+                    .lines
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, dl)| dl.origin == side || dl.origin == LineOrigin::Context)
+                    .map(|(i, _)| i)
+                    .collect();
+                let src: Vec<&str> = idx
+                    .iter()
+                    .map(|&i| hunk.lines[i].content.as_str())
+                    .collect();
+                let rendered = render_lines(theme, &src, v);
+                for (k, &li) in idx.iter().enumerate() {
+                    let dl = &mut hunk.lines[li];
+                    // Context rows take the new side's rendering.
+                    if dl.origin == side || side == LineOrigin::Addition {
+                        dl.highlighted_spans = Some(rendered[k].clone());
+                    }
+                }
+            }
+        }
+    }
+}
